# Copy to .env. Never put a real secret in this file.
BACKEND_PORT=8000
FRONTEND_PORT=5173
# local   = no GPU, no sandbox, no key: scripted agent + fixture reader.
# nim     = LLM agent through the endpoints below.
# sandbox = the agent runs in OpenShell.

CLAIMS_MODE=local
# fixture = expected.json of the mock documents. omni = Nemotron 3 Nano Omni (intern).
CLAIMS_READER=fixture
# NVIDIA credential. Put the real value in .env only. Same name as in NemoForge.
NVIDIA_KEY=
# Model endpoints (docs/DECISIONS.md, D15 and D17). Not used in local mode.
VLM_BASE_URL=https://integrate.api.nvidia.com/v1
VLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
AGENT_BASE_URL=https://integrate.api.nvidia.com/v1
AGENT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Later (specialised chain, D16):
OCR_URL=
PAGE_ELEMENTS_URL=
TABLE_STRUCTURE_URL=
PARSE_URL=
