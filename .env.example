# Copy to .env. Never put a real secret in this file.
BACKEND_PORT=8000
FRONTEND_PORT=5173
# local   = no GPU, no sandbox, no key: scripted agent + fixture reader.
# nim     = LangGraph agent (decision D36) through the endpoints below.
# sandbox = the agent runs in OpenShell.

CLAIMS_MODE=local
# fixture = expected.json of the mock documents. omni = Nemotron 3 Nano Omni (intern).
CLAIMS_READER=fixture
# NVIDIA credential. Put the real value in .env only. Same name as in NemoForge.
NVIDIA_KEY=
# Model endpoints (docs/DECISIONS.md, D15 and D17). Not used in local mode.
VLM_BASE_URL=https://integrate.api.nvidia.com/v1
VLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
AGENT_BASE_URL=https://integrate.api.nvidia.com/v1
# Chosen by the measure of docs/EVALUATION.md (D17).
AGENT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Empty = the model default. off = reasoning off (chat_template_kwargs.enable_thinking).
AGENT_THINKING=
# SQLite file of the agent checkpoints (nim mode). The demo reset empties it.
CLAIMS_CHECKPOINTS=.dev-data/checkpoints.sqlite
# sandbox mode (run infra/sandbox/setup.sh once). The backend must listen on 127.0.0.1
# at BACKEND_PORT: the sandbox reaches it as host.openshell.internal:BACKEND_PORT.
# CLAIMS_SANDBOX_IMAGE=claims-agent:1
# Policy file of each sandbox (it holds the token of the sandbox: mode 0600).
# CLAIMS_SANDBOX_DIR=.dev-data/sandboxes
# Seconds before a turn in a sandbox is stopped, the sandbox deleted, the fallback sent.
# CLAIMS_SANDBOX_TURN_TIMEOUT=150
# Later (specialised chain, D16):
OCR_URL=
PAGE_ELEMENTS_URL=
TABLE_STRUCTURE_URL=
PARSE_URL=
